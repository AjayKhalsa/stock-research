# StockLens environment — copy to .env in the repo root and fill in values.
# Backend loads this automatically (see backend/main.py).

# Required for AI thesis generation (optional — app works without it)
GEMINI_API_KEY=

# Optional: override Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: persistent directory for SQLite/cache data in hosted deployments.
# Point this at a mounted disk; local development defaults to backend/data.
# STOCKLENS_DATA_DIR=/var/data/stocklens

# Optional Kite Connect (legacy — not required; prices use Yahoo Finance)
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=

# Required to call the protected daily analysis job using Authorization: Bearer <secret>.
# Use the same value for GitHub repository secret STOCKLENS_CRON_SECRET.
# Leave unset to keep the endpoint disabled entirely.
# CRON_SECRET_KEY=

# Feature flag for the new Morning/Sectors/Candidates workspace.
# CFO_WORKSPACE_V1=true

# Optional: public Chartink screen used only for a custom filtered subset.
# The primary daily universe comes from NSE's official equity master.
# CHARTINK_SCREENER_URL=https://chartink.com/screener/copy-general-scanner-simply-above-mas-3

# Production: Supabase Postgres session-pooler URL. URL-encode reserved
# characters in the password. Local development can omit this and use SQLite.
# DATABASE_URL=
# DB_POOL_SIZE=6

# Emergency-only: permit a configured Postgres deployment to fall back to
# ephemeral SQLite. Keep false in production to prevent silent data loss.
# ALLOW_EPHEMERAL_DB_FALLBACK=false

# Frontend (copy to frontend/.env.local for Create React App)
# REACT_APP_API_URL=http://localhost:8000
# REACT_APP_CFO_WORKSPACE_V1=true
