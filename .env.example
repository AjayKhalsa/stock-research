# StockLens environment — copy to .env in the repo root and fill in values.
# Backend loads this automatically (see backend/main.py).

# Required for AI thesis generation (optional — app works without it)
GEMINI_API_KEY=

# Optional: override Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: persistent directory for SQLite/cache data in hosted deployments.
# Point this at a mounted disk; local development defaults to backend/data.
# STOCKLENS_DATA_DIR=/var/data/stocklens

# Optional Kite Connect (legacy — not required; prices use Yahoo Finance)
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=

# Required to call POST /api/auto-screen (the Chartink daily auto-fetcher cron
# endpoint) — pick any long random string. Leave unset to keep the endpoint
# disabled entirely.
# CRON_SECRET_KEY=

# Optional: default public Chartink screen used by the Refresh list action.
# CHARTINK_SCREENER_URL=https://chartink.com/screener/copy-general-scanner-simply-above-mas-3

# Optional: switches db.py from local SQLite to Postgres (e.g. a free Neon
# database) so the watchlist/saved screens/paper trades survive restarts.
# DATABASE_URL=

# Frontend (copy to frontend/.env.local for Create React App)
# REACT_APP_API_URL=http://localhost:8000
